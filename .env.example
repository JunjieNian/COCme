# Copy to .env.local (not committed) and fill in real values.

# Codex SDK. Authentication is reused from the local `codex login` session;
# no OpenAI/DeepSeek API key is used.
CODEX_MODEL_CHAT=gpt-5.4-mini
CODEX_MODEL_REASON=gpt-5.4-mini
CODEX_REASONING_EFFORT=low

# Local auth: HMAC secret for the session cookie. >= 16 chars.
# Example: openssl rand -hex 32
SESSION_SECRET=change-me-to-32-hex-chars-for-prod

# Local database directory (JSON files). Default: ./data
# LOCAL_DATA_DIR=/var/lib/coc/data

# Supabase (optional, unused by default -- all storage is local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
